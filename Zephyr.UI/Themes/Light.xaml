<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="ZephyrBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="ZephyrSurfaceColor">#FFFAFAFA</Color>
    <Color x:Key="ZephyrElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="ZephyrOverlayColor">#FFEBEBEB</Color>

    <!-- Text -->
    <Color x:Key="ZephyrTextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="ZephyrTextSecondaryColor">#FF606060</Color>
    <Color x:Key="ZephyrTextDisabledColor">#FFA0A0A0</Color>

    <!-- Borders -->
    <Color x:Key="ZephyrBorderColor">#FFD0D0D0</Color>
    <Color x:Key="ZephyrBorderSubtleColor">#FFE8E8E8</Color>

    <!-- Interactive states -->
    <Color x:Key="ZephyrHoverColor">#FFE5E5E5</Color>
    <Color x:Key="ZephyrPressedColor">#FFD8D8D8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ZephyrBackground"    Color="{StaticResource ZephyrBackgroundColor}"/>
    <SolidColorBrush x:Key="ZephyrSurface"       Color="{StaticResource ZephyrSurfaceColor}"/>
    <SolidColorBrush x:Key="ZephyrElevated"      Color="{StaticResource ZephyrElevatedColor}"/>
    <SolidColorBrush x:Key="ZephyrOverlay"       Color="{StaticResource ZephyrOverlayColor}"/>
    <SolidColorBrush x:Key="ZephyrTextPrimary"   Color="{StaticResource ZephyrTextPrimaryColor}"/>
    <SolidColorBrush x:Key="ZephyrTextSecondary" Color="{StaticResource ZephyrTextSecondaryColor}"/>
    <SolidColorBrush x:Key="ZephyrTextDisabled"  Color="{StaticResource ZephyrTextDisabledColor}"/>
    <SolidColorBrush x:Key="ZephyrBorder"        Color="{StaticResource ZephyrBorderColor}"/>
    <SolidColorBrush x:Key="ZephyrBorderSubtle"  Color="{StaticResource ZephyrBorderSubtleColor}"/>
    <SolidColorBrush x:Key="ZephyrHover"         Color="{StaticResource ZephyrHoverColor}"/>
    <SolidColorBrush x:Key="ZephyrPressed"       Color="{StaticResource ZephyrPressedColor}"/>
    <SolidColorBrush x:Key="ZephyrCopiedBrush"   Color="#2E7D32"/>

</ResourceDictionary>
