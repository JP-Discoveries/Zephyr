<UserControl x:Class="Zephyr.UI.Controls.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zephyr.UI.ViewModels"
             xmlns:controls="clr-namespace:Zephyr.UI.Controls"
             xmlns:search="clr-namespace:Zephyr.Core.Search;assembly=Zephyr.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- Tab bar -->
            <RowDefinition Height="44"/>   <!-- Nav bar -->
            <RowDefinition Height="Auto"/> <!-- Filter bar -->
            <RowDefinition Height="Auto"/> <!-- Search status -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="34"/>   <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- ── Tab Bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource ZephyrBackground}"
                BorderBrush="{DynamicResource ZephyrBorder}"
                BorderThickness="0,0,0,1"
                PreviewMouseLeftButtonDown="TabBar_PreviewMouseDown"
                PreviewMouseMove="TabBar_PreviewMouseMove"
                LostMouseCapture="TabBar_LostCapture">
            <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <Button Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="0" Margin="0" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBd" MinWidth="80" MaxWidth="180"
                                                BorderBrush="{DynamicResource ZephyrBorder}"
                                                BorderThickness="1,1,1,0" Background="Transparent"
                                                CornerRadius="6,6,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle x:Name="AccentLine" Height="2" VerticalAlignment="Top"
                                                           Fill="{DynamicResource ZephyrAccent}" Visibility="Collapsed"/>
                                                <Grid VerticalAlignment="Center" Margin="10,2,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TabHeader" Grid.Column="0" Text="{Binding Header}"
                                                               Foreground="{DynamicResource ZephyrTextSecondary}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="13"/>
                                                    <Button Grid.Column="1" Padding="3,2" Margin="5,0,0,0" Opacity="0.7"
                                                            ToolTip="Close Tab"
                                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;"
                                                                   FontSize="10" Foreground="{DynamicResource ZephyrTextSecondary}"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource ZephyrSurface}"/>
                                                <Setter TargetName="AccentLine" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="TabHeader" Property="Foreground" Value="{DynamicResource ZephyrTextPrimary}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource ZephyrHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Width="36" VerticalAlignment="Stretch"
                        Command="{Binding NewTabCommand}" ToolTip="New Tab (Ctrl+T)">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="12"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ── Navigation Bar ───────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource ZephyrSurface}"
                BorderBrush="{DynamicResource ZephyrBorder}"
                BorderThickness="0,0,0,1" Padding="4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Back -->
                    <ColumnDefinition Width="Auto"/>   <!-- Fwd -->
                    <ColumnDefinition Width="Auto"/>   <!-- Up -->
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>      <!-- Breadcrumb -->
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>   <!-- Refresh -->
                    <ColumnDefinition Width="Auto"/>   <!-- Flat view -->
                    <ColumnDefinition Width="Auto"/>   <!-- Filter toggle -->
                    <ColumnDefinition Width="Auto"/>   <!-- View mode -->
                    <ColumnDefinition Width="Auto"/>   <!-- Preview pane -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="32" Height="32"
                        Command="{Binding ActiveTab.GoBackCommand}" ToolTip="Back (Alt+Left)">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;" FontSize="14"/>
                </Button>
                <Button Grid.Column="1" Width="32" Height="32"
                        Command="{Binding ActiveTab.GoForwardCommand}" ToolTip="Forward (Alt+Right)">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72A;" FontSize="14"/>
                </Button>
                <Button Grid.Column="2" Width="32" Height="32"
                        Command="{Binding ActiveTab.GoUpCommand}" ToolTip="Up (Alt+Up)">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74A;" FontSize="14"/>
                </Button>

                <!-- Breadcrumb / Address -->
                <Border Grid.Column="4" x:Name="BreadcrumbBorder"
                        Background="{DynamicResource ZephyrElevated}"
                        BorderBrush="{DynamicResource ZephyrBorder}"
                        BorderThickness="1" CornerRadius="6"
                        Height="30" VerticalAlignment="Center"
                        Cursor="IBeam" ClipToBounds="True"
                        MouseLeftButtonDown="BreadcrumbArea_Click">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" Focusable="False"
                                      Visibility="{Binding ActiveTab.IsEditingPath, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ActiveTab.BreadcrumbSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding Name}" Padding="3,0" FontSize="13"
                                                    Command="{Binding DataContext.ActiveTab.NavigateToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FullPath}"/>
                                            <TextBlock Text="›" FontSize="15" Margin="1,0"
                                                       Foreground="{DynamicResource ZephyrTextSecondary}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox x:Name="AddressBox"
                                 Text="{Binding ActiveTab.CurrentPath, Mode=OneWay}"
                                 Visibility="{Binding ActiveTab.IsEditingPath, Converter={StaticResource BoolToVis}}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" Margin="8,0"
                                 KeyDown="AddressBox_KeyDown"
                                 GotFocus="AddressBox_GotFocus"
                                 LostFocus="AddressBox_LostFocus"/>
                    </Grid>
                </Border>

                <Button Grid.Column="6" Width="32" Height="32"
                        Command="{Binding ActiveTab.RefreshCommand}" ToolTip="Refresh (F5)">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="14"/>
                </Button>

                <!-- Flat view toggle (show all files from subfolders) -->
                <Button Grid.Column="7" Width="32" Height="32"
                        Command="{Binding ActiveTab.ToggleFlatViewCommand}"
                        ToolTip="{Binding ActiveTab.FlatViewTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab.FlatView}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ZephyrAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8DA;" FontSize="14"/>
                </Button>

                <!-- Filter toggle -->
                <Button Grid.Column="8" Width="32" Height="32" ToolTip="Filters">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab.ShowFilterBar}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ZephyrAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71C;" FontSize="14"/>
                    <Button.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ActiveTab.ToggleFilterBarCommand}"/>
                    </Button.InputBindings>
                </Button>

                <!-- View mode toggle (Details ↔ Thumbnails) -->
                <Button Grid.Column="9" Width="32" Height="32" ToolTip="Toggle view (Details / Thumbnails)"
                        Command="{Binding ActiveTab.ToggleViewModeCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab.ShowIconView}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ZephyrAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C9;" FontSize="14"/>
                </Button>

                <!-- Preview pane toggle -->
                <Button Grid.Column="10" Width="32" Height="32" ToolTip="Preview pane"
                        Command="{Binding ActiveTab.TogglePreviewPaneCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab.ShowPreviewPane}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ZephyrAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A9;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Filter Bar ────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Visibility="{Binding ActiveTab.ShowFilterBar, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ZephyrSurface}"
                BorderBrush="{DynamicResource ZephyrBorder}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Padding="10,3" Margin="8,0,0,0"
                        Command="{Binding ActiveTab.ClearFiltersCommand}"
                        ToolTip="Reset all filters"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Type" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                    <ComboBox MinWidth="130" FontSize="12" Margin="0,0,14,0"
                              ItemsSource="{Binding ActiveTab.DynamicTypeFilterOptions}"
                              SelectedItem="{Binding ActiveTab.SelectedTypeFilter, Mode=TwoWay}"/>
                    <TextBlock Text="Size" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                    <ComboBox MinWidth="110" FontSize="12" Margin="0,0,14,0"
                              DisplayMemberPath="Key"
                              ItemsSource="{x:Static vm:TabViewModel.SizeFilterOptions}"
                              SelectedValue="{Binding ActiveTab.ActiveSizeFilter, Mode=TwoWay}"
                              SelectedValuePath="Value"/>
                    <TextBlock Text="Date" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                    <ComboBox MinWidth="110" FontSize="12"
                              DisplayMemberPath="Key"
                              ItemsSource="{x:Static vm:TabViewModel.DateFilterOptions}"
                              SelectedValue="{Binding ActiveTab.ActiveDateFilter, Mode=TwoWay}"
                              SelectedValuePath="Value"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Search Status Bar ─────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Visibility="{Binding ActiveTab.IsSearchMode, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ZephyrSurface}"
                BorderBrush="{DynamicResource ZephyrBorder}"
                BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="80" Height="3" Margin="10,0"
                             VerticalAlignment="Center" IsIndeterminate="True" BorderThickness="0"
                             Foreground="{DynamicResource ZephyrAccent}"
                             Background="{DynamicResource ZephyrBorder}"
                             Visibility="{Binding ActiveTab.IsSearching, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" FontSize="12"
                               Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource ZephyrTextSecondary}">
                        <Run Text="Results for "/>
                        <Run Text="{Binding ActiveTab.SearchQuery, Mode=OneWay}"
                             FontWeight="SemiBold" Foreground="{DynamicResource ZephyrTextPrimary}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding ActiveTab.Items.Count, Mode=OneWay}"/>
                        <Run Text=" found"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Content: File Lists + Preview Pane ────────────────────────── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding ActiveTab.ShowPreviewPane, Converter={StaticResource BoolToGridLength}, ConverterParameter=4}"/>
                <ColumnDefinition Width="{Binding ActiveTab.ShowPreviewPane, Converter={StaticResource BoolToGridLength}, ConverterParameter=290}"/>
            </Grid.ColumnDefinitions>

            <!-- File list area -->
            <Grid Grid.Column="0">

                <!-- Details view -->
                <ListView x:Name="FileList"
                          ItemsSource="{Binding ActiveTab.Items}"
                          SelectionMode="Extended" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Visibility="{Binding ActiveTab.ShowDetailsView, Converter={StaticResource BoolToVis}}"
                          SelectionChanged="FileList_SelectionChanged"
                          AllowDrop="True"
                          PreviewKeyDown="List_PreviewKeyDown"
                          PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                          MouseMove="List_MouseMove"
                          PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                          DragOver="List_DragOver"
                          Drop="List_Drop">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding CompareStatus, Converter={StaticResource CompareStatusToBrush}}"
                                                    Visibility="{Binding HasCompareStatus, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding CompareStatus}"/>
                                            <Image Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Converter={StaticResource ShellIconConverter}}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            <Border Width="9" Height="9" CornerRadius="4.5" Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding LabelColor, Converter={StaticResource HexToBrush}}"
                                                    Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Colour label"/>
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource ZephyrTextSecondary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Text" Value="&#xE72E;"/>
                                                        <Setter Property="ToolTip" Value="Locked folder"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                <Setter Property="Text" Value="&#xE785;"/>
                                                                <Setter Property="ToolTip" Value="Unlocked for this session"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CloudBadge}" FontSize="10"
                                                       VerticalAlignment="Center" Margin="5,0,0,0"
                                                       Foreground="{DynamicResource ZephyrTextSecondary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CloudBadge}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size"          DisplayMemberBinding="{Binding SizeDisplay}"      Width="80"/>
                            <GridViewColumn Header="Date Modified" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd  HH:mm}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type"          DisplayMemberBinding="{Binding TypeDisplay}"      Width="120"/>
                            <GridViewColumn Header="Date Created" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Created, StringFormat={}{0:yyyy-MM-dd  HH:mm}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Extension"    DisplayMemberBinding="{Binding Extension}"         Width="80"/>
                            <GridViewColumn Header="Attributes"   DisplayMemberBinding="{Binding AttributeDisplay}"  Width="70"/>
                            <GridViewColumn Header="Contents"     DisplayMemberBinding="{Binding ContentSummary}"    Width="160"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource GridViewItemStyle}">
                            <EventSetter Event="MouseDoubleClick" Handler="OpenItem_DoubleClick"/>
                            <Setter Property="Background"
                                    Value="{Binding CompareStatus, Converter={StaticResource CompareStatusToBrush}, ConverterParameter=tint}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ClipboardState}" Value="Cut">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ClipboardState}" Value="Copied">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZephyrCopiedBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecentlyInteracted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZephyrAccent}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Search results / flat view -->
                <ListView x:Name="SearchResultList"
                          ItemsSource="{Binding ActiveTab.Items}"
                          SelectionMode="Extended" BorderThickness="0"
                          Visibility="{Binding ActiveTab.ShowListView, Converter={StaticResource BoolToVis}}"
                          SelectionChanged="SearchResultList_SelectionChanged"
                          AllowDrop="True"
                          PreviewKeyDown="List_PreviewKeyDown"
                          PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                          DragOver="List_DragOver"
                          Drop="List_Drop">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding CompareStatus, Converter={StaticResource CompareStatusToBrush}}"
                                                    Visibility="{Binding HasCompareStatus, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding CompareStatus}"/>
                                            <Image Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Converter={StaticResource ShellIconConverter}}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            <Border Width="9" Height="9" CornerRadius="4.5" Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding LabelColor, Converter={StaticResource HexToBrush}}"
                                                    Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Colour label"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Location" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SearchLocation}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SearchLocation}"
                                                   Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size"          DisplayMemberBinding="{Binding SizeDisplay}" Width="75"/>
                            <GridViewColumn Header="Date Modified" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd  HH:mm}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource GridViewItemStyle}">
                            <EventSetter Event="MouseDoubleClick" Handler="OpenItem_DoubleClick"/>
                            <Setter Property="Background"
                                    Value="{Binding CompareStatus, Converter={StaticResource CompareStatusToBrush}, ConverterParameter=tint}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ClipboardState}" Value="Cut">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ClipboardState}" Value="Copied">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZephyrCopiedBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecentlyInteracted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZephyrAccent}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Thumbnail / icon view -->
                <ListBox x:Name="IconView"
                         ItemsSource="{Binding ActiveTab.Items}"
                         SelectionMode="Extended" BorderThickness="0"
                         Background="{DynamicResource ZephyrBackground}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding ActiveTab.ShowIconView, Converter={StaticResource BoolToVis}}"
                         SelectionChanged="IconView_SelectionChanged"
                         AllowDrop="True"
                         PreviewKeyDown="List_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                         MouseMove="List_MouseMove"
                         PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                         DragOver="List_DragOver"
                         Drop="List_Drop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel
                                ItemWidth="{Binding DataContext.ActiveTab.ThumbnailContainerSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ItemHeight="{Binding DataContext.ActiveTab.ThumbnailContainerSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- No fixed Width — panel spreads items to fill available row width -->
                            <Grid Height="{Binding DataContext.ActiveTab.ThumbnailContainerSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Border Height="{Binding DataContext.ActiveTab.ThumbnailPixelSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="{DynamicResource ZephyrElevated}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                        ClipToBounds="True" Margin="2,2,2,0">
                                    <Grid>
                                        <Image Stretch="Uniform" Margin="8"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Converter={StaticResource ShellIconConverter}, ConverterParameter=large}"/>
                                        <Image Source="{Binding ThumbnailImage}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="4" CornerRadius="3" Padding="3,1"
                                                Background="#CC000000"
                                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="ToolTip" Value="Locked folder"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                            <Setter Property="ToolTip" Value="Unlocked for this session"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE72E;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                <Setter Property="Text" Value="&#xE785;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Width="12" Height="12" CornerRadius="6" Margin="5"
                                                BorderBrush="White" BorderThickness="1.5"
                                                Background="{Binding LabelColor, Converter={StaticResource HexToBrush}}"
                                                Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Colour label"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Width="12" Height="12" CornerRadius="6" Margin="5"
                                                BorderBrush="White" BorderThickness="1.5"
                                                Background="{Binding CompareStatus, Converter={StaticResource CompareStatusToBrush}}"
                                                Visibility="{Binding HasCompareStatus, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Compare status"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxHeight="{Binding DataContext.ActiveTab.ThumbnailNameHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                           Margin="4,0,4,2" FontSize="11"
                                           Foreground="{DynamicResource ZephyrTextPrimary}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <EventSetter Event="MouseDoubleClick" Handler="OpenItem_DoubleClick"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ClipboardState}" Value="Cut">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ClipboardState}" Value="Copied">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZephyrCopiedBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecentlyInteracted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZephyrAccent}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Visibility="{Binding ActiveTab.ShowPreviewPane, Converter={StaticResource BoolToVis}}"/>

            <controls:PreviewPane Grid.Column="2"
                                  DataContext="{Binding ActiveTab}"
                                  Visibility="{Binding ActiveTab.ShowPreviewPane, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ── Address History Popup ────────────────────────────────────── -->
        <Popup x:Name="AddressHistoryPopup"
               Grid.Row="1"
               Placement="Bottom"
               StaysOpen="True">
            <Border Background="{DynamicResource ZephyrSurface}"
                    BorderBrush="{DynamicResource ZephyrBorder}"
                    BorderThickness="1" Padding="3">
                <ListBox x:Name="HistoryListBox"
                         MaxHeight="260"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="AddressHistoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,5"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>

        <!-- ── Bottom Bar ────────────────────────────────────────────────── -->
        <Border Grid.Row="5"
                Background="{DynamicResource ZephyrSurface}"
                BorderBrush="{DynamicResource ZephyrBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter input -->
                <Border Grid.Column="0"
                        Background="{DynamicResource ZephyrElevated}"
                        BorderBrush="{DynamicResource ZephyrBorder}"
                        BorderThickness="1" CornerRadius="5"
                        Height="22" VerticalAlignment="Center"
                        Width="284" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons" Text="&#xE721;"
                                   FontSize="10" Margin="5,0,3,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ZephyrTextSecondary}" IsHitTestVisible="False"/>
                        <TextBox x:Name="BottomSearchBox" Grid.Column="1"
                                 Text="{Binding ActiveTab.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="11"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="Type to filter · Enter for deep search · Esc to clear"/>
                        <Button Grid.Column="2" Width="18" Height="18" Padding="0"
                                Command="{Binding ActiveTab.ClearSearchCommand}"
                                Visibility="{Binding ActiveTab.IsSearchMode, Converter={StaticResource BoolToVis}}"
                                ToolTip="Clear search">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9"
                                       Foreground="{DynamicResource ZephyrTextSecondary}"/>
                        </Button>
                        <!-- Scope toggle: current folder ↔ all subfolders -->
                        <Button Grid.Column="3" Width="18" Height="18" Padding="0" Margin="1,0,0,0"
                                Command="{Binding ActiveTab.ToggleSearchScopeCommand}"
                                ToolTip="{Binding ActiveTab.SearchScopeTooltip}">
                            <Grid>
                                <!-- All subfolders (recursive) -->
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8DA;"
                                           FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ZephyrAccent}"
                                           Visibility="{Binding ActiveTab.SearchRecursive, Converter={StaticResource BoolToVis}}"/>
                                <!-- Current folder only -->
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;"
                                           FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ZephyrTextSecondary}"
                                           Visibility="{Binding ActiveTab.SearchRecursive, Converter={StaticResource InverseBoolToVis}}"/>
                            </Grid>
                        </Button>
                        <!-- Content toggle: match file names ↔ file contents (grep) -->
                        <Button Grid.Column="4" Width="18" Height="18" Padding="0" Margin="1,0,0,0"
                                Command="{Binding ActiveTab.ToggleContentSearchCommand}"
                                ToolTip="{Binding ActiveTab.MatchContentTooltip}">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C3;" FontSize="9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ZephyrTextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab.MatchContent}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ZephyrAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="5" Width="18" Height="18" Padding="0" Margin="1,0,2,0"
                                Command="{Binding ActiveTab.StartDeepSearchCommand}"
                                ToolTip="Search (Enter)">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE773;" FontSize="9"
                                       Foreground="{DynamicResource ZephyrTextSecondary}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right: summary + view size slider -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveTab.ItemSummaryText}"
                               FontSize="11" Foreground="{DynamicResource ZephyrTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- Details icon — lit when at 0 -->
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand"
                               MouseLeftButtonDown="DetailsIcon_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ZephyrTextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab.ShowDetailsView}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ZephyrAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Size slider: 0 = Details, 1-100 = thumbnail size -->
                    <Slider Width="90" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            Value="{Binding ActiveTab.ThumbnailSize}"
                            VerticalAlignment="Center"
                            ToolTip="View size — drag right for larger thumbnails"/>

                    <!-- Thumbnail icon — lit when > 0 -->
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C9;" FontSize="14"
                               VerticalAlignment="Center" Margin="4,0,4,0" Cursor="Hand"
                               MouseLeftButtonDown="ThumbnailsIcon_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ZephyrTextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab.ShowIconView}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ZephyrAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Quick Preview Overlay (Space bar) ───────────────────────── -->
        <Grid x:Name="QuickPreviewOverlay"
              Grid.Row="0" Grid.RowSpan="6"
              Visibility="Collapsed"
              MouseLeftButtonDown="QuickPreviewOverlay_MouseDown">
            <Rectangle x:Name="QuickPreviewBackdrop" Fill="#88000000"/>
            <Border Background="{DynamicResource ZephyrSurface}"
                    BorderBrush="{DynamicResource ZephyrBorder}"
                    BorderThickness="1" CornerRadius="8"
                    MaxWidth="700" MaxHeight="540"
                    MinWidth="320" MinHeight="180"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24" MouseLeftButtonDown="QuickPreviewCard_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="14,10,10,10"
                            BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Width="28" Height="28" Padding="0"
                                    Click="QuickPreviewClose_Click">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="11"/>
                            </Button>
                            <TextBlock x:Name="QuickPreviewTitle"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource ZephyrTextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Row="1">
                        <!-- Image -->
                        <ScrollViewer x:Name="QuickPreviewImageScroll"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <StackPanel>
                                <!-- Single image (image files) -->
                                <Image x:Name="QuickPreviewImage" Stretch="Uniform" Margin="12"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- Rendered PDF pages, stacked vertically -->
                                <ItemsControl x:Name="QuickPreviewPdfPages" Margin="12,12,12,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12"
                                                    BorderBrush="{DynamicResource ZephyrBorder}"
                                                    BorderThickness="1">
                                                <Image Source="{Binding}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Text -->
                        <ScrollViewer x:Name="QuickPreviewTextScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <TextBox x:Name="QuickPreviewText"
                                     IsReadOnly="True"
                                     FontFamily="Consolas,Courier New" FontSize="12"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="NoWrap" Padding="12,8"
                                     Foreground="{DynamicResource ZephyrTextPrimary}"/>
                        </ScrollViewer>

                        <!-- File / folder info -->
                        <StackPanel x:Name="QuickPreviewInfo"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="20">
                            <TextBlock x:Name="QuickPreviewInfoIcon"
                                       FontFamily="Segoe Fluent Icons" FontSize="64"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ZephyrAccent}"
                                       Margin="0,0,0,14"/>
                            <TextBlock x:Name="QuickPreviewInfoType"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="QuickPreviewInfoSize"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock x:Name="QuickPreviewInfoDate"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Footer hint -->
                    <Border Grid.Row="2" Padding="12,7"
                            BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="0,1,0,0">
                        <TextBlock Text="&#x2191;&#x2193; browse  ·  Space or Esc to close"
                                   Foreground="{DynamicResource ZephyrTextSecondary}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
