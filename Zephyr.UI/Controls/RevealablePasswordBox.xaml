<UserControl x:Class="Zephyr.UI.Controls.RevealablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource ZephyrElevated}"
            BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
            CornerRadius="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Masked editor (default) -->
            <PasswordBox x:Name="Pwd" Grid.Column="0" FontSize="13" Padding="6,4"
                         BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         PasswordChanged="Pwd_Changed"/>

            <!-- Plain editor (shown while revealed) -->
            <TextBox x:Name="Plain" Grid.Column="0" FontSize="13" Padding="6,4"
                     BorderThickness="0" Background="Transparent"
                     VerticalContentAlignment="Center"
                     Visibility="Collapsed"
                     Foreground="{DynamicResource ZephyrTextPrimary}"
                     TextChanged="Plain_Changed"/>

            <!-- Reveal toggle -->
            <ToggleButton x:Name="Eye" Grid.Column="1" Width="34"
                          Background="Transparent" Cursor="Hand"
                          ToolTip="Show password"
                          Checked="Eye_Checked" Unchecked="Eye_Unchecked">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZephyrHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <TextBlock x:Name="EyeGlyph" FontFamily="Segoe Fluent Icons" Text="&#xE7B3;"
                           FontSize="14" Foreground="{DynamicResource ZephyrTextSecondary}"/>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
