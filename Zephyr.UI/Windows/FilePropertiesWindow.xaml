<Window x:Class="Zephyr.UI.Windows.FilePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="540"
        Icon="{StaticResource ZephyrAppIcon}"
        ResizeMode="CanResizeWithGrip" MinWidth="380" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Tab Control ═════════════════════════════════════════════════ -->
        <TabControl Grid.Row="0">

            <!-- ── General ───────────────────────────────────────────────── -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,12">

                        <!-- Icon + name -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock x:Name="IconGlyph"
                                       FontFamily="Segoe Fluent Icons" FontSize="40"
                                       Foreground="{DynamicResource ZephyrTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock x:Name="NameText"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ZephyrTextPrimary}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="310"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource ZephyrBorder}" Margin="0,0,0,12"/>

                        <!-- Properties -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"  Grid.Column="0" Text="Type:"     FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="0"  Grid.Column="1" x:Name="TypeText"     FontSize="13" Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="2"  Grid.Column="0" Text="Location:" FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2"  Grid.Column="1" x:Name="LocationText" FontSize="13" Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="4"  Grid.Column="0" Text="Size:"     FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="4"  Grid.Column="1" x:Name="SizeText"     FontSize="13" Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="5"  Grid.Column="0" x:Name="ContainsLabel" Text="Contains:" FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}" VerticalAlignment="Top" Visibility="Collapsed" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="5"  Grid.Column="1" x:Name="ContainsText"  FontSize="13" Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="7"  Grid.Column="0" Text="Created:"  FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="7"  Grid.Column="1" x:Name="CreatedText"   FontSize="13" Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="9"  Grid.Column="0" Text="Modified:" FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="9"  Grid.Column="1" x:Name="ModifiedText"  FontSize="13" Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Accessed:" FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" x:Name="AccessedText"  FontSize="13" Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource ZephyrBorder}" Margin="0,14,0,12"/>

                        <!-- Attributes -->
                        <TextBlock Text="Attributes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ReadOnlyCheck" Content="Read-only" Margin="0,0,0,5"/>
                        <CheckBox x:Name="HiddenCheck"   Content="Hidden"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Details ───────────────────────────────────────────────── -->
            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DetailsItems" Margin="16,10,16,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Section header -->
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ZephyrTextSecondary}"
                                               Margin="0,10,0,3"
                                               Visibility="{Binding IsSection, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Property row -->
                                    <Grid Margin="0,2"
                                          Visibility="{Binding IsSection, Converter={StaticResource InverseBoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Grid.Column="0"
                                                   FontSize="12" Foreground="{DynamicResource ZephyrTextSecondary}"
                                                   VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Value}" Grid.Column="1"
                                                   FontSize="12" Foreground="{DynamicResource ZephyrTextPrimary}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- ── Security ──────────────────────────────────────────────── -->
            <TabItem Header="Security">
                <Grid Margin="16,14,16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Object path -->
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Left" Text="Object:" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="SecurityPathText" FontSize="12"
                                   Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- Owner -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Left" Text="Owner:" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OwnerText" FontSize="12"
                                   Foreground="{DynamicResource ZephyrTextPrimary}" TextWrapping="Wrap"/>
                    </DockPanel>

                    <!-- Permissions label -->
                    <TextBlock Grid.Row="4" Text="Permissions:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>

                    <!-- Permissions list -->
                    <Border Grid.Row="6"
                            BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
                            CornerRadius="4" ClipToBounds="True">
                        <ListView x:Name="PermissionsList" BorderThickness="0"
                                  Background="{DynamicResource ZephyrElevated}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Principal" Width="185" DisplayMemberBinding="{Binding Principal}"/>
                                    <GridViewColumn Header="Type"      Width="52"  DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="Access"               DisplayMemberBinding="{Binding Rights}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource GridViewItemStyle}"/>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>


            <!-- ── Customize ─────────────────────────────────────────────── -->
            <TabItem Header="Customize">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,12">

                        <!-- Shown only for non-folders -->
                        <TextBlock x:Name="NotFolderNotice"
                                   Text="Icon customization is only available for folders."
                                   FontSize="13" Foreground="{DynamicResource ZephyrTextSecondary}"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>

                        <!-- All customize controls (folders only) -->
                        <StackPanel x:Name="CustomizeContent">

                            <!-- Folder type ───────────────────────────────── -->
                            <TextBlock Text="What kind of folder do you want?"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ZephyrTextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Optimize this folder for:"
                                       FontSize="12" Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FolderTypeCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <ComboBoxItem Tag="Generic"   Content="General items" IsSelected="True"/>
                                <ComboBoxItem Tag="Documents" Content="Documents"/>
                                <ComboBoxItem Tag="Pictures"  Content="Pictures"/>
                                <ComboBoxItem Tag="Music"     Content="Music"/>
                                <ComboBoxItem Tag="Videos"    Content="Videos"/>
                            </ComboBox>
                            <CheckBox x:Name="ApplyToSubfoldersCheck"
                                      Content="Also apply this template to all subfolders"/>

                            <Rectangle Height="1" Fill="{DynamicResource ZephyrBorder}" Margin="0,14,0,14"/>

                            <!-- Folder pictures ────────────────────────────── -->
                            <TextBlock Text="Folder pictures" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ZephyrTextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="You can put a picture on this folder to help identify its contents."
                                       FontSize="12" Foreground="{DynamicResource ZephyrTextSecondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Border x:Name="FolderPicturePreview" Width="64" Height="64"
                                    HorizontalAlignment="Left" Margin="0,0,0,8"
                                    Background="{DynamicResource ZephyrElevated}"
                                    BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
                                    CornerRadius="4" Visibility="Collapsed">
                                <Image x:Name="FolderPictureImage" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose File…"    Width="110" Margin="0,0,8,0" Click="ChooseFolderPicture_Click"/>
                                <Button Content="Restore Default" Width="110"                  Click="RestoreFolderPicture_Click"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource ZephyrBorder}" Margin="0,14,0,14"/>

                            <!-- Folder icons ────────────────────────────────── -->
                            <TextBlock Text="Folder icons" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ZephyrTextPrimary}" Margin="0,0,0,8"/>
                            <Border Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,8"
                                    Background="{DynamicResource ZephyrElevated}"
                                    BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <TextBlock x:Name="CustomIconGlyph" Text="&#xE8B7;"
                                               FontFamily="Segoe Fluent Icons" FontSize="44"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ZephyrAccent}"/>
                                    <Image x:Name="CustomIconImage" Stretch="Uniform"
                                           Margin="8" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Change Icon…"     Width="110" Margin="0,0,8,0" Click="ChangeIcon_Click"/>
                                <Button Content="Restore Defaults" Width="110"                  Click="RestoreIcon_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ══ Buttons ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Fill="{DynamicResource ZephyrBorder}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="16,10,16,12">
                <Button Content="OK"     Width="80" Margin="0,0,8,0" Click="OK_Click"/>
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Apply"  Width="80" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
