<Window x:Class="Zephyr.UI.Dialogs.ExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract" Height="Auto" Width="520"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Destination -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Multi-archive layout -->
            <RowDefinition Height="Auto"/>  <!-- Password -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   Foreground="{DynamicResource ZephyrTextPrimary}"
                   FontSize="13" TextWrapping="Wrap"/>

        <!-- Destination -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Extract To"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestBox" Grid.Column="0" FontSize="13" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
                <Button Grid.Column="2" Content="Browse…" Click="Browse_Click"/>
            </Grid>
        </StackPanel>

        <!-- Multi-archive layout (only shown when extracting >1 archive) -->
        <StackPanel Grid.Row="4" x:Name="LayoutPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Multiple Archives"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <RadioButton x:Name="SubfolderRadio" GroupName="Layout" IsChecked="True"
                         Content="Extract each to its own subfolder"
                         Margin="0,2" Foreground="{DynamicResource ZephyrTextPrimary}"/>
            <RadioButton x:Name="SameFolderRadio" GroupName="Layout"
                         Content="Extract all into the destination folder"
                         Margin="0,2" Foreground="{DynamicResource ZephyrTextPrimary}"/>
        </StackPanel>

        <!-- Password (optional, for encrypted archives) -->
        <StackPanel Grid.Row="5">
            <TextBlock Text="Password (if required)"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" FontSize="13" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"  Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Extract" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
