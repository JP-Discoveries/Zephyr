<Window x:Class="Zephyr.UI.Dialogs.ZephyrMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr" Width="380"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height"
        Background="{DynamicResource ZephyrSurface}">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0"
                   TextWrapping="Wrap" MaxWidth="340"
                   Foreground="{DynamicResource ZephyrTextPrimary}"
                   FontSize="13" LineHeight="20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Width="75" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="Cancel_Click"
                    Background="{DynamicResource ZephyrElevated}"
                    BorderBrush="{DynamicResource ZephyrBorder}"
                    BorderThickness="1"/>
            <Button x:Name="OkBtn" Content="OK" Width="75"
                    IsDefault="True" Click="OK_Click"
                    Background="{DynamicResource ZephyrElevated}"
                    BorderBrush="{DynamicResource ZephyrBorder}"
                    BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
