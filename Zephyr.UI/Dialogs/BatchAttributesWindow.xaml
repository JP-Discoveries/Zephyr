<Window x:Class="Zephyr.UI.Dialogs.BatchAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attributes &amp; Timestamps" Width="500" Height="Auto"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/> <!-- Attributes -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/> <!-- Timestamps -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/> <!-- Recursive -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="26" Text="&#xE713;"
                       Foreground="{DynamicResource ZephyrAccent}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ZephyrTextPrimary}"/>
                <TextBlock Text="Leave a field unchanged to keep its current value."
                           FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource ZephyrTextSecondary}"/>
            </StackPanel>
        </StackPanel>

        <!-- Attributes -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="ATTRIBUTES" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Read-only" FontSize="12" Margin="0,0,0,3"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                    <ComboBox x:Name="ReadOnlyBox" SelectedIndex="0">
                        <ComboBoxItem Content="Leave unchanged"/>
                        <ComboBoxItem Content="Set"/>
                        <ComboBoxItem Content="Clear"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Hidden" FontSize="12" Margin="0,0,0,3"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                    <ComboBox x:Name="HiddenBox" SelectedIndex="0">
                        <ComboBoxItem Content="Leave unchanged"/>
                        <ComboBoxItem Content="Set"/>
                        <ComboBoxItem Content="Clear"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="System" FontSize="12" Margin="0,0,0,3"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                    <ComboBox x:Name="SystemBox" SelectedIndex="0">
                        <ComboBoxItem Content="Leave unchanged"/>
                        <ComboBoxItem Content="Set"/>
                        <ComboBoxItem Content="Clear"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Archive" FontSize="12" Margin="0,0,0,3"
                               Foreground="{DynamicResource ZephyrTextSecondary}"/>
                    <ComboBox x:Name="ArchiveBox" SelectedIndex="0">
                        <ComboBoxItem Content="Leave unchanged"/>
                        <ComboBoxItem Content="Set"/>
                        <ComboBoxItem Content="Clear"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Timestamps -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="TIMESTAMPS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="CreatedCheck" Grid.Column="0" Content="Created"
                          VerticalAlignment="Center" Checked="TimestampToggle" Unchecked="TimestampToggle"/>
                <TextBox x:Name="CreatedBox" Grid.Column="1" IsEnabled="False" FontFamily="Consolas" FontSize="12" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
                <Button Grid.Column="3" Content="Now" Width="54" Tag="Created" Click="Now_Click"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ModifiedCheck" Grid.Column="0" Content="Modified"
                          VerticalAlignment="Center" Checked="TimestampToggle" Unchecked="TimestampToggle"/>
                <TextBox x:Name="ModifiedBox" Grid.Column="1" IsEnabled="False" FontFamily="Consolas" FontSize="12" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
                <Button Grid.Column="3" Content="Now" Width="54" Tag="Modified" Click="Now_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="AccessedCheck" Grid.Column="0" Content="Accessed"
                          VerticalAlignment="Center" Checked="TimestampToggle" Unchecked="TimestampToggle"/>
                <TextBox x:Name="AccessedBox" Grid.Column="1" IsEnabled="False" FontFamily="Consolas" FontSize="12" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
                <Button Grid.Column="3" Content="Now" Width="54" Tag="Accessed" Click="Now_Click"/>
            </Grid>

            <TextBlock Text="Format: yyyy-MM-dd HH:mm:ss" FontSize="10" Margin="0,5,0,0"
                       Foreground="{DynamicResource ZephyrTextSecondary}"/>
        </StackPanel>

        <!-- Recursive -->
        <CheckBox Grid.Row="6" x:Name="RecursiveCheck"
                  Content="Also apply to the contents of selected folders (recursive)"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Apply"  Width="90" IsDefault="True" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
