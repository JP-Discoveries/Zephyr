<Window x:Class="Zephyr.UI.Dialogs.ChecksumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checksum" Width="640" Height="Auto"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="Auto"/> <!-- Hash rows -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/> <!-- Verify -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/> <!-- Compare -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="FileGlyph" FontFamily="Segoe Fluent Icons" FontSize="30"
                       Foreground="{DynamicResource ZephyrAccent}"
                       VerticalAlignment="Center" Margin="0,0,12,0" Text="&#xE8A5;"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ZephyrTextPrimary}"
                           TextTrimming="CharacterEllipsis" MaxWidth="540"/>
                <TextBlock x:Name="SubText" FontSize="11"
                           Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Progress -->
        <Grid Grid.Row="2" x:Name="ProgressRow" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="HashProgress" Grid.Column="0" Height="6" Minimum="0" Maximum="1"
                         VerticalAlignment="Center"
                         Style="{StaticResource ZephyrProgressBar}"/>
            <TextBlock x:Name="StatusText" Grid.Column="2" FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ZephyrTextSecondary}"/>
            <Button x:Name="CancelHashButton" Grid.Column="4" Content="Cancel" Width="74"
                    Click="CancelHash_Click"/>
        </Grid>

        <!-- Hash rows -->
        <StackPanel Grid.Row="3">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MD5" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="11"/>
                <TextBox x:Name="Md5Box" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Padding="6,4" Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
                <Button Grid.Column="3" Width="30" Click="Copy_Click" Tag="{Binding ElementName=Md5Box}"
                        ToolTip="Copy">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" FontSize="12"/>
                </Button>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SHA-1" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="11"/>
                <TextBox x:Name="Sha1Box" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Padding="6,4" Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
                <Button Grid.Column="3" Width="30" Click="Copy_Click" Tag="{Binding ElementName=Sha1Box}"
                        ToolTip="Copy">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" FontSize="12"/>
                </Button>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SHA-256" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="11"/>
                <TextBox x:Name="Sha256Box" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Padding="6,4" Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"/>
                <Button Grid.Column="3" Width="30" Click="Copy_Click" Tag="{Binding ElementName=Sha256Box}"
                        ToolTip="Copy">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" FontSize="12"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Verify -->
        <StackPanel Grid.Row="5">
            <TextBlock Text="Verify — paste an expected hash"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VerifyBox" Grid.Column="0" FontFamily="Consolas" FontSize="12" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"
                         TextChanged="VerifyBox_TextChanged"/>
                <TextBlock x:Name="VerifyResult" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>

        <!-- Compare -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="CompareButton" Content="Compare File…" Width="120"
                    Click="Compare_Click"/>
            <TextBlock Grid.Column="2" x:Name="CompareResult" VerticalAlignment="Center"
                       FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="90" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
