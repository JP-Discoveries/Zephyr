<Window x:Class="Zephyr.UI.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Zephyr.UI.Controls"
        Title="Password Required" Height="Auto" Width="420"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Prompt -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Password -->
            <RowDefinition Height="Auto"/>  <!-- Error -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText"
                   Foreground="{DynamicResource ZephyrTextPrimary}"
                   FontSize="13" TextWrapping="Wrap"/>

        <controls:RevealablePasswordBox Grid.Row="2" x:Name="PasswordBox"/>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Text="" Margin="0,6,0,0"
                   Foreground="#E06C6C" FontSize="11" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK"     Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
