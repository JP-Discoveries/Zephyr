<Window x:Class="Zephyr.UI.Dialogs.DiskUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Zephyr.UI.Controls"
        Title="Disk Usage" Width="1320" Height="700"
        MinWidth="820" MinHeight="440"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>     <!-- Treemap + legend -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/> <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="UpButton" Width="34" Height="30" Padding="0" Margin="0,0,10,0"
                    Click="Up_Click" IsEnabled="False" ToolTip="Up one level">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74A;" FontSize="14"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PathText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource ZephyrTextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TotalText" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource ZephyrTextSecondary}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="ScanProgress" Width="140" Height="6" IsIndeterminate="True"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Style="{StaticResource ZephyrProgressBar}"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="74" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>

        <!-- Folder tree + treemap + legend -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="180"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="392"/>
            </Grid.ColumnDefinitions>

            <!-- Folder breakdown tree -->
            <Border Grid.Column="0" Background="{DynamicResource ZephyrSurface}"
                    BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="6,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FOLDERS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource ZephyrTextSecondary}" Margin="6,0,0,8"/>
                    <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource ZephyrTextPrimary}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource ZephyrTextPrimary}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="2,2"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PercentDisplay}" FontSize="11"
                                               Foreground="{DynamicResource ZephyrTextSecondary}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FilesDisplay}" FontSize="11"
                                               Foreground="{DynamicResource ZephyrTextSecondary}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="11"
                                               Foreground="{DynamicResource ZephyrTextSecondary}"
                                               TextAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Treemap -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
                    CornerRadius="4" ClipToBounds="True">
                <controls:TreemapControl x:Name="Treemap"/>
            </Border>

            <!-- File-type table (sortable: click a column header) -->
            <Border Grid.Column="4" Background="{DynamicResource ZephyrSurface}"
                    BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FILE TYPES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource ZephyrTextSecondary}" Margin="2,0,0,8"/>
                    <ListView x:Name="FileTypeList" BorderThickness="0" Background="Transparent"
                              ButtonBase.Click="TypeHeader_Click"
                              ItemContainerStyle="{StaticResource GridViewItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Extension" Width="96">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,7,0"
                                                        VerticalAlignment="Center" Background="{Binding Swatch}"/>
                                                <TextBlock Text="{Binding Ext}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="File Type" Width="110"
                                                DisplayMemberBinding="{Binding FileType}"/>
                                <GridViewColumn Header="%" Width="46"
                                                DisplayMemberBinding="{Binding PercentDisplay}"/>
                                <GridViewColumn Header="Size" Width="68"
                                                DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="Files" Width="56"
                                                DisplayMemberBinding="{Binding FilesDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Background="{DynamicResource ZephyrSurface}"
                BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
                CornerRadius="4" Padding="10,6">
            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       TextTrimming="CharacterEllipsis"
                       Text="Hover a block to see its file and size · double-click a folder to zoom in"/>
        </Border>
    </Grid>
</Window>
