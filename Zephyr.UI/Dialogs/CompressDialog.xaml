<Window x:Class="Zephyr.UI.Dialogs.CompressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compress" Height="Auto" Width="520"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Name -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Location -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Format + Level -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Encryption (zip only) -->
            <RowDefinition Height="Auto"/>  <!-- Summary -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Archive name -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Archive Name"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" FontSize="13" Padding="6,4"
                     Background="{DynamicResource ZephyrElevated}"
                     Foreground="{DynamicResource ZephyrTextPrimary}"
                     BorderBrush="{DynamicResource ZephyrBorder}"
                     TextChanged="Input_Changed"/>
        </StackPanel>

        <!-- Location -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Location"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LocationBox" Grid.Column="0" FontSize="13" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"
                         TextChanged="Input_Changed"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…"
                        Click="Browse_Click"/>
            </Grid>
        </StackPanel>

        <!-- Format + Compression level -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Format"
                           Foreground="{DynamicResource ZephyrTextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="FormatBox" FontSize="13"
                          SelectionChanged="Format_Changed">
                    <ComboBoxItem Content=".zip"    Tag="Zip"   IsSelected="True"/>
                    <ComboBoxItem Content=".tar.gz" Tag="TarGz"/>
                    <ComboBoxItem Content=".tar"    Tag="Tar"/>
                    <ComboBoxItem Content=".gz"     Tag="Gz"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Compression"
                           Foreground="{DynamicResource ZephyrTextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="LevelBox" FontSize="13">
                    <ComboBoxItem Content="Store (no compression)" Tag="Store"/>
                    <ComboBoxItem Content="Fastest"                Tag="Fastest"/>
                    <ComboBoxItem Content="Normal"                 Tag="Normal" IsSelected="True"/>
                    <ComboBoxItem Content="Maximum"                Tag="Maximum"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Encryption (zip only) -->
        <StackPanel Grid.Row="6" x:Name="EncryptionPanel" Margin="0,0,0,10">
            <TextBlock Text="Password (optional — encrypts the .zip)"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" Grid.Column="0" FontSize="13" Padding="6,4"
                             Background="{DynamicResource ZephyrElevated}"
                             Foreground="{DynamicResource ZephyrTextPrimary}"
                             BorderBrush="{DynamicResource ZephyrBorder}"
                             PasswordChanged="Password_Changed"/>
                <PasswordBox x:Name="ConfirmBox" Grid.Column="2" FontSize="13" Padding="6,4"
                             Background="{DynamicResource ZephyrElevated}"
                             Foreground="{DynamicResource ZephyrTextPrimary}"
                             BorderBrush="{DynamicResource ZephyrBorder}"
                             PasswordChanged="Password_Changed"/>
                <ComboBox x:Name="EncMethodBox" Grid.Column="4" FontSize="13" VerticalAlignment="Center">
                    <ComboBoxItem Content="AES-256 (secure)"      Tag="Aes256" IsSelected="True"/>
                    <ComboBoxItem Content="ZipCrypto (compatible)" Tag="ZipCrypto"/>
                </ComboBox>
            </Grid>
            <TextBlock x:Name="EncryptHintText" Margin="0,4,0,0"
                       Foreground="{DynamicResource ZephyrTextSecondary}"
                       FontSize="10" TextWrapping="Wrap"
                       Text="Confirm box on the right. AES-256 is secure but not openable by Windows Explorer; ZipCrypto is weak but universally compatible."/>
        </StackPanel>

        <!-- Summary / hint -->
        <TextBlock Grid.Row="7" x:Name="SummaryText"
                   Foreground="{DynamicResource ZephyrTextSecondary}"
                   FontSize="11" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"   Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Compress" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
