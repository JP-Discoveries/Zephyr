<Window x:Class="Zephyr.UI.Dialogs.AddNetworkLocationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Network Location" Width="500" Height="Auto"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource ZephyrTextSecondary}"
                   Text="Pin a network share or folder for quick access. Enter a UNC path (e.g. \\server\share), a mapped drive, or any folder."/>

        <!-- Path -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Location" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" FontSize="13" Padding="6,4"
                         Background="{DynamicResource ZephyrElevated}"
                         Foreground="{DynamicResource ZephyrTextPrimary}"
                         BorderBrush="{DynamicResource ZephyrBorder}"
                         TextChanged="Path_Changed"/>
                <Button Grid.Column="2" Content="Browse…" Click="Browse_Click"/>
            </Grid>
        </StackPanel>

        <!-- Name -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Display name" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource ZephyrTextSecondary}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" FontSize="13" Padding="6,4"
                     Background="{DynamicResource ZephyrElevated}"
                     Foreground="{DynamicResource ZephyrTextPrimary}"
                     BorderBrush="{DynamicResource ZephyrBorder}"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Add"    Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
