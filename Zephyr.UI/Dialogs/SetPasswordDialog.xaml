<Window x:Class="Zephyr.UI.Dialogs.SetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Zephyr.UI.Controls"
        Title="Lock Folder" Height="Auto" Width="430"
        Icon="{StaticResource ZephyrAppIcon}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource ZephyrBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Prompt -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Password label -->
            <RowDefinition Height="Auto"/>  <!-- Password -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- Confirm label -->
            <RowDefinition Height="Auto"/>  <!-- Confirm -->
            <RowDefinition Height="Auto"/>  <!-- Error -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- Warning -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText"
                   Foreground="{DynamicResource ZephyrTextPrimary}"
                   FontSize="13" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Password" Margin="0,0,0,3"
                   Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="11"/>
        <controls:RevealablePasswordBox Grid.Row="3" x:Name="PasswordBox"/>

        <TextBlock Grid.Row="5" Text="Confirm password" Margin="0,0,0,3"
                   Foreground="{DynamicResource ZephyrTextSecondary}" FontSize="11"/>
        <controls:RevealablePasswordBox Grid.Row="6" x:Name="ConfirmBox"/>

        <TextBlock Grid.Row="7" x:Name="ErrorText" Text="" Margin="0,6,0,0"
                   Foreground="#E06C6C" FontSize="11" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <Border Grid.Row="9" Background="{DynamicResource ZephyrElevated}"
                BorderBrush="{DynamicResource ZephyrBorder}" BorderThickness="1"
                CornerRadius="5" Padding="10,7">
            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource ZephyrTextSecondary}">
                <Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons"/>
                <Run Text="  There is no password recovery. If you forget this password the folder stays locked in Zephyr — though its files remain accessible from Windows Explorer, since this is a visibility lock, not encryption."/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"     Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Lock"       Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
