# Normalize text files to LF in the repo, checkout per-platform.
* text=auto

# Windows scripts MUST be CRLF in the working tree — cmd.exe misparses
# label lookups (goto/call) in LF-only batch files, which makes the
# console flash open and close instead of running.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf
